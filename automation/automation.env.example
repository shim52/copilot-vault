# copilot-vault automation config — written by install.sh; edit by hand any time (no reload needed).
VAULT_PATH="/Users/you/Vault"
CLAUDE_BIN=""                       # empty = first `claude` on PATH
MODEL="claude-sonnet-5-5"
WORKDAYS="1,2,3,4,5"                # ISO weekdays, 1=Mon … 7=Sun (e.g. "7,1,2,3,4" for Sun–Thu)
STAGE1_TIMEOUT="5400"               # seconds before the pass is killed
NETWORK_WAIT="300"                  # seconds to wait for a stable network on cold wakes

# Delivery (the ONLY outbound channel; the agent cannot send anything itself)
NOTIFY_BACKEND="file"               # slack | discord | webhook | ntfy | desktop | file | none
NOTIFY_URL_FILE="$HOME/.copilot-vault/notify-url"   # webhook URL kept in a chmod-600 file
NOTIFY_FILE="$HOME/.copilot-vault/inbox.md"         # for the file backend
NOTIFY_TITLE="Vault"
DIGEST_PATH="$HOME/.copilot-vault/last-run-summary.txt"

# Read-only connector tools the pass may call (space-separated MCP tool names, exactly as your
# Claude Code lists them). Anything NOT listed is refused — add tools here, never widen elsewhere.
CONNECTOR_TOOLS=""
CONNECTORS_LINE="calendar=no chat=no tracker=no"
